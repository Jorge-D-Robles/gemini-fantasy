[resource]
script = ExtResource("1_script")
id = &"garrick_three_burns"
title = "Three Burns"
description = "Garrick scratched the crest off his shield and kept walking. He doesn't talk about what he did under the Shepherds of Silence -- the three villages he burned in the Cindral Wastes. The third one killed his daughter Mara, a healer who'd left the order at fourteen. Her Echo still drifts in the ruins. Find her. He owes her that much."
objectives = ["Find Mara's name at the Emberhearth memorial wall.", "Follow the fragment compass to the ruins of Ashpyre.", "Face Mara's Echo in the deep Wastes."]
reward_gold = 0
reward_exp = 500
reward_item_ids = []
quest_type = 2
prerequisites = []
