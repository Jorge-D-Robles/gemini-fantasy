[resource]
script = ExtResource("1_script")
id = &"kael_fragments_of_self"
title = "Fragments of Self"
description = "Scattered across Aethermoor, Kael discovers Echo fragments that seem to contain their childhood memories -- the ones they've never had. But each fragment tells a different story. The contradictions force Kael toward a truth they've been circling since the beginning: if my past is a story I told myself, does the person I am now still count?"
objectives = ["Find the locket in Kael's cottage.", "Investigate the sealed laboratory in the Overgrown Capital.", "Follow the crystal resonance at the Hollows border.", "Talk to Garrick about losing your story.", "Face the Gallery of Selves in the Resonance Nexus."]
reward_gold = 0
reward_exp = 500
reward_item_ids = []
quest_type = 2
prerequisites = []
