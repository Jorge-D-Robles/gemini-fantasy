; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] key=value

config_version=5

[application]

config/name="Crystal Saga"
config/description="A tutorial JRPG built with Godot 4"
run/main_scene="res://ui/title_screen/title_screen.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[autoload]

SceneManager="*res://autoloads/scene_manager.tscn"
InventoryManager="*res://autoloads/inventory_manager.gd"
GameManager="*res://autoloads/game_manager.gd"
QuestManager="*res://autoloads/quest_manager.gd"
PartyManager="*res://autoloads/party_manager.gd"
SaveManager="*res://autoloads/save_manager.gd"
MusicManager="*res://autoloads/music_manager.tscn"
PauseMenu="*res://ui/pause_menu/pause_menu.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

